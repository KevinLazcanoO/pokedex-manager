# Copia este archivo a `.env` antes de arrancar la API.
# `npm run setup` lo hace por ti y además genera un JWT_SECRET aleatorio.
#
# NUNCA subas tu `.env` al repositorio: está en .gitignore por ese motivo.

# Ruta del archivo SQLite, relativa a la carpeta `prisma/`.
DATABASE_URL="file:./dev.db"

# Puerto en el que escucha la API.
PORT=4000

# Clave con la que se firman los tokens de sesión.
# Este valor es solo un marcador: `npm run setup` lo reemplaza por uno aleatorio.
# Si creas el .env a mano, genera el tuyo:  openssl rand -base64 48
JWT_SECRET="marcador-sin-valor-reemplazalo-por-uno-aleatorio"

# Cuánto dura la sesión antes de volver a pedir login.
JWT_EXPIRES_IN="7d"


# ─── Análisis con IA (opcional) ──────────────────────────────────────────────
#
# La aplicación funciona entera sin esto. Si no pones clave, el análisis de la
# colección aparece como no disponible y no se hace ninguna llamada externa.
#
# Para activarlo necesitas TU PROPIA clave de la API de Anthropic. Se crea en
# https://console.anthropic.com  ->  API Keys. Es de pago por uso.
#
# La clave se queda en tu máquina: solo la lee el servidor, nunca se envía al
# navegador ni aparece en las respuestas de la API.
#
# ANTHROPIC_API_KEY="sk-ant-..."

# Límites de uso, pensados para que nadie pueda dispararle el gasto a tu clave.
# Se pueden ajustar, pero los valores por defecto son sensatos.
AI_LIMITE_POR_USUARIO_AL_DIA=10
AI_LIMITE_GLOBAL_AL_DIA=100
